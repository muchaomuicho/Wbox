<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0-windows</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>Wbox.Backend</AssemblyName><Version>0.7.2</Version></PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''"><PublishTrimmed>true</PublishTrimmed><TrimMode>partial</TrimMode><JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault></PropertyGroup>
  <ItemGroup><TrimmerRootAssembly Include="Wbox.Backend" /><TrimmerRootAssembly Include="YamlDotNet" /></ItemGroup>
  <ItemGroup>
    <Content Include="../../resources/runtime/bundled/**/*" Exclude="../../resources/runtime/bundled/rules/mihomo-anti-ad.yaml" Link="bundled/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../Wbox/Geodata.cs;../Wbox/BundledRules.cs;../Wbox/StartupRegistration.cs" />
    <Content Include="../../resources/geodata/*" Link="geodata/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Compile Include="../Wbox/LogFormatting.cs;../Wbox/ProxyCatalog.cs;../Wbox/SubscriptionRefresh.cs;../Wbox/SubscriptionUsage.cs" />
    <Compile Include="../Wbox/GlobalUsings.cs;../Wbox/Models.cs;../Wbox/NodeParser.cs;../Wbox/NodeEditing.cs;../Wbox/NodeOptions.cs;../Wbox/ConfigBuilder.cs;../Wbox/CoreManager.cs;../Wbox/StartupPolicy.cs;../Wbox/ProcessJob.cs;../Wbox/SystemProxy.cs;../Wbox/ProfileImport.cs;../Wbox/DisplayFormat.cs" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <Content Include="../../resources/cores/windows/*" Link="cores/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
