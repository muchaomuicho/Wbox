<Window x:Class="Wbox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Wbox" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Style="{StaticResource {x:Type Window}}" TextOptions.TextFormattingMode="Display" Title="Wbox" Width="1200" Height="850" WindowStyle="None" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Grid Background="#1F1F1F">
    <Grid.ColumnDefinitions><ColumnDefinition Width="264"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#181818" BorderBrush="#333333" BorderThickness="0,0,1,0">
      <Grid Margin="16,30,16,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Margin="12,0,0,28"><TextBlock Text="Wbox" FontFamily="Georgia" FontSize="34" FontWeight="Bold"/><TextBlock Text="0.4.0" Foreground="#858585" FontFamily="Consolas" FontSize="14" Margin="0,8,0,0"/></StackPanel>
          <TextBlock Text="工作区" Style="{StaticResource Caption}" Margin="12,0,0,8"/>
          <Border Background="#242424" CornerRadius="10" Padding="4" Margin="0,0,0,26"><UniformGrid Columns="2"><RadioButton x:Name="ConfigMode" Content="配置" GroupName="Mode" Padding="16,10" Checked="ModeChanged"/><RadioButton x:Name="NodeMode" Content="节点" GroupName="Mode" Padding="16,10" Checked="ModeChanged"/></UniformGrid></Border>
        </StackPanel>
        <StackPanel x:Name="NavigationPanel" Grid.Row="1">
          <RadioButton Style="{StaticResource Navigation}" Content="概览" Tag="&#xE80F;" GroupName="Navigation" IsChecked="True" Click="NavigateClick"/>
          <RadioButton x:Name="NodesNav" Style="{StaticResource Navigation}" Content="节点" Tag="&#xE774;" GroupName="Navigation" Click="NavigateClick"/>
          <RadioButton x:Name="ProfilesNav" Style="{StaticResource Navigation}" Content="订阅" Tag="&#xE8A5;" GroupName="Navigation" Click="NavigateClick"/>
          <RadioButton Style="{StaticResource Navigation}" Content="连接" Tag="&#xE839;" GroupName="Navigation" Click="NavigateClick"/>
          <RadioButton Style="{StaticResource Navigation}" Content="日志" Tag="&#xE8F1;" GroupName="Navigation" Click="NavigateClick"/>
          <RadioButton Style="{StaticResource Navigation}" Content="设置" Tag="&#xE713;" GroupName="Navigation" Click="NavigateClick"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="12,0"><TextBlock x:Name="SidebarCore" Text="sing-box" Foreground="#B6B6B6"/><TextBlock Text="IPv6 · 双内核" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <Border Background="#181818" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="16,0,0,0" MouseLeftButtonDown="TitleDrag"><DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="─" Width="46" Margin="0" Background="Transparent" Click="MinimizeClick"/><Button Content="□" Width="46" Margin="0" Background="Transparent" Click="MaximizeClick"/><Button Content="×" FontSize="23" Width="46" Margin="0" Background="Transparent" Click="CloseClick"/></StackPanel>
        <Button x:Name="StartButton" Content="▶" FontFamily="Consolas" FontSize="15" MinWidth="74" Background="#282828" Foreground="#BBBBBB" Padding="13,12" Margin="0,0,16,0" VerticalAlignment="Center" Click="StartClick" ToolTip="启动 / 停止连接"/>
        <TextBlock x:Name="PageTitle" Text="概览" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="PageCaption" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,18,0"/>
      </DockPanel></Border>
      <TabControl Foreground="{StaticResource Ink}" x:Name="MainTabs" Grid.Row="1" Margin="40,36,40,0" BorderThickness="0" Background="Transparent" SelectionChanged="PageChanged">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem Header="概览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="↑   上传" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="UploadRate" Text="0 B/s" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="UploadTotal" Text="0 B" Style="{StaticResource Caption}" Margin="0,8,0,0"/><local:TrafficChart x:Name="Chart" Series="Upload" Height="60" Margin="0,22,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="↓   下载" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DownloadRate" Text="0 B/s" FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="DownloadTotal" Text="0 B" Style="{StaticResource Caption}" Margin="0,8,0,0"/><local:TrafficChart x:Name="DownloadChart" Series="Download" Height="60" Margin="0,22,0,0"/></StackPanel></Border>
          </Grid>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="状态" Style="{StaticResource SectionTitle}"/><DockPanel Margin="0,0,0,12"><TextBlock Text="内核内存" Style="{StaticResource Caption}"/><TextBlock x:Name="CoreMemoryLabel" Text="—" FontSize="17" HorizontalAlignment="Right"/></DockPanel><DockPanel><TextBlock Text="界面内存" Style="{StaticResource Caption}"/><TextBlock x:Name="MemoryLabel" Text="—" FontSize="17" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="连接" Style="{StaticResource SectionTitle}"/><DockPanel Margin="0,0,0,12"><TextBlock Text="入站 / 出站" Style="{StaticResource Caption}"/><TextBlock x:Name="ConnectionCount" Text="0 / 0" FontSize="17" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="当前活动逻辑流" Style="{StaticResource Caption}"/></StackPanel></Border>
          </Grid>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="接管方式" Style="{StaticResource SectionTitle}"/><Border Background="#1F1F1F" BorderBrush="#373737" BorderThickness="1" CornerRadius="12" Padding="3"><UniformGrid Columns="2"><RadioButton x:Name="ManagedInbound" Content="系统代理" GroupName="InboundMode" Checked="InboundModeChanged"/><RadioButton x:Name="NativeInbound" Content="配置原生入站 / TUN" GroupName="InboundMode" Checked="InboundModeChanged"/></UniformGrid></Border><TextBlock x:Name="InboundHint" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><DockPanel Margin="0,0,0,14"><Button Content="选择  ›" DockPanel.Dock="Right" Click="OpenProfilesClick" Margin="16,0,0,0"/><TextBlock Text="配置" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" Margin="0"/></DockPanel>
          <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StateGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#A0A0A0" FontSize="19" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Foreground="#E5E5E5" x:Name="StateLabel" Text="尚未连接" FontSize="16"/><TextBlock x:Name="ConnectionHint" Text="添加配置或节点开始连接" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="2" Background="#292929" CornerRadius="7" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="ModeBadge" Text="节点工作区" Style="{StaticResource Caption}"/></Border></Grid>
<TextBlock x:Name="OverviewFootnote" Style="{StaticResource Caption}"/></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="NodesTab" Header="节点"><Grid>
          <Grid x:Name="NodeWorkspace"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="＋ 添加" Click="ShowImportClick"/><Button Content="测试所选" Click="DelayNodeClick"/><Button x:Name="DelayAllButton" Content="测试全部" Click="DelayAllClick"/><Button Content="删除" Click="DeleteNodeClick" Margin="0"/></StackPanel><TextBlock x:Name="NodesHeading" Text="节点" FontSize="17" VerticalAlignment="Center"/></DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="NodeFilter" SelectionChanged="NodeFilterChanged"/><TextBox Tag="搜索名称、地址或协议" x:Name="NodeSearch" Grid.Column="2" TextChanged="NodeSearchChanged" ToolTip="搜索节点名称、地址或协议"/></Grid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="NodesList" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="NodeChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTemplateColumn Header="名称" Width="*" MinWidth="180"><DataGridTemplateColumn.CellTemplate><DataTemplate><local:FlagLabel Value="{Binding Name}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="95"/><DataGridTextColumn Header="地址" Binding="{Binding Server}" Width="160"/><DataGridTextColumn Header="传输" Binding="{Binding TransportText}" Width="95"/><DataGridTextColumn Header="延迟" Binding="{Binding DelayText}" Width="82"/></DataGrid.Columns></DataGrid><StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=NodesList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="还没有节点" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="添加分享链接，或到订阅页面添加订阅" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Grid></Border>
          </Grid>
          <Grid x:Name="GroupWorkspace" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="GroupCards"/></ScrollViewer><TextBlock x:Name="GroupsEmpty" Text="连接配置后，代理组会显示在这里" Foreground="#929292" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        </Grid></TabItem>
        <TabItem x:Name="ProfilesTab" Header="订阅"><Grid>
          <Grid x:Name="ConfigWorkspace" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><DockPanel><TextBlock Text="添加配置" Style="{StaticResource SectionTitle}"/><Button Content="导入本地文件" Click="ChooseConfigClick" HorizontalAlignment="Right" Margin="0"/></DockPanel><TextBlock Text="远程地址" Style="{StaticResource Caption}" Margin="0,6,0,8"/><DockPanel><Button Content="添加远程配置" Click="RemoteConfigClick" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox Tag="https://example.com/config" x:Name="RemoteConfigUrl" ToolTip="HTTPS 地址，无需 .json / .yaml 后缀"/></DockPanel><TextBlock Text="自动识别 JSON / YAML，保留完整路由、DNS 与代理组。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
            <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="我的配置" FontSize="16"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="更新远程" Click="UpdateConfigClick"/><Button Content="移除" Click="RemoveConfigClick" Margin="0"/></StackPanel></DockPanel><ListBox x:Name="ConfigsList" Grid.Row="1" SelectionChanged="ConfigSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
          </Grid>
          <StackPanel x:Name="SubscriptionWorkspace"><Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="添加节点订阅" Style="{StaticResource SectionTitle}"/><DockPanel><Button Content="添加 / 更新" Click="SubscriptionClick" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox Tag="https://example.com/subscription" x:Name="SubscriptionBox" ToolTip="HTTP / HTTPS 订阅链接，支持无文件后缀的地址"/></DockPanel><TextBlock Text="支持 Base64、分享链接列表，以及 JSON / YAML 中的节点。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="已保存的订阅" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="SavedSubscriptionsBox" SelectionChanged="SubscriptionSelected"/><WrapPanel Margin="0,18,0,0"><Button Content="更新全部订阅" Click="UpdateAllSubscriptionsClick"/><Button Content="移除所选订阅" Click="RemoveSubscriptionClick"/></WrapPanel></StackPanel></Border></StackPanel>
        </Grid></TabItem>
        <TabItem Header="连接"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <TextBox x:Name="ConnectionSearch" Tag="⌕   搜索目标、来源、入站或出站" Background="#282828" Margin="0,0,0,16" TextChanged="ConnectionSearchChanged"/>
          <ListBox x:Name="ConnectionsList" Grid.Row="1" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate>
            <Border Background="#282828" BorderBrush="#3C3C3C" BorderThickness="1" CornerRadius="17" Padding="18,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <DockPanel><Border DockPanel.Dock="Right" Background="#34403A" CornerRadius="12" Padding="10,4" Margin="12,0,0,0"><TextBlock Text="活动" Foreground="#90B8A4" FontSize="12"/></Border><Border DockPanel.Dock="Left" Background="#3B3B3B" CornerRadius="12" Padding="10,4" Margin="0,0,10,0"><TextBlock Text="{Binding Network}" Foreground="#B5B5B5" FontSize="12"/></Border><TextBlock Text="{Binding Destination}" FontFamily="Consolas, Microsoft YaHei UI" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Destination}"/></DockPanel>
              <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="55*"/><ColumnDefinition Width="45*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding UpText}" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13"/><TextBlock Text="{Binding DownText}" FontFamily="Consolas" Foreground="#AAAAAA" FontSize="13" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding Inbound}" HorizontalAlignment="Right" Foreground="#AAAAAA" ToolTip="{Binding Source}"/><TextBlock Text="{Binding Outbound}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Foreground="#AAAAAA" Margin="0,6,0,0" ToolTip="{Binding Rule}"/></StackPanel></Grid>
            </Grid></Border>
          </DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock x:Name="ConnectionsEmpty" Grid.Row="1" Text="暂无活动连接" Foreground="#929292" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid></TabItem>
        <TabItem Header="日志"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><TextBox x:Name="LogSearch" Tag="⌕   搜索日志" Width="260" TextChanged="LogSearchChanged"/><TextBlock Text="最近 500 条" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="PauseLogsButton" Content="暂停" Click="PauseLogsClick"/><Button Content="复制" Click="CopyLogsClick"/><Button Content="清空" Click="ClearLogsClick" Margin="0"/></StackPanel></DockPanel><ListBox x:Name="LogsList" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#B0B0B0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Grid></Border></TabItem>
        <TabItem Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <StackPanel x:Name="SettingsHome"><TextBlock Text="设置" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,24"/>
            <Button Content="应用                         ›" HorizontalContentAlignment="Left" Padding="24" Margin="0,0,0,12" FontSize="17" Tag="app" Click="SettingsOpenClick"/>
            <Button Content="内核与接管                   ›" HorizontalContentAlignment="Left" Padding="24" Margin="0,0,0,12" FontSize="17" Tag="core" Click="SettingsOpenClick"/>
            <Button Content="延迟测试                     ›" HorizontalContentAlignment="Left" Padding="24" Margin="0,0,0,12" FontSize="17" Tag="test" Click="SettingsOpenClick"/>
            <TextBlock Text="Wbox 0.4.0" Style="{StaticResource Caption}" Margin="0,24,0,6"/><TextBlock Text="mihomo 1.19.33 / sing-box 1.14.4" Style="{StaticResource Caption}"/>
          </StackPanel>
          <StackPanel x:Name="SettingsDetail" Visibility="Collapsed"><Button Content="‹  返回设置" HorizontalAlignment="Left" Background="Transparent" Margin="0,0,0,24" Click="SettingsBackClick"/>
            <Border x:Name="AppSettings" Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="应用" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AutoStartCheck" Content="开机启动"/><CheckBox x:Name="SilentCheck" Content="静默启动到托盘"/><CheckBox x:Name="AutoConnectCheck" Content="启动后自动连接"/><Button Content="打开数据目录" HorizontalAlignment="Left" Margin="0,20,0,0" Click="OpenDataClick"/></StackPanel></Border>
            <Border x:Name="CoreSettings" Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="内核与接管" Style="{StaticResource SectionTitle}"/><TextBlock Text="节点工作区内核" Margin="0,0,0,12"/><ComboBox x:Name="CoreBox" SelectionChanged="CoreChanged"><ComboBoxItem Content="mihomo"/><ComboBoxItem Content="sing-box"/></ComboBox><CheckBox x:Name="SystemProxyCheck" Content="连接时设置 Windows 系统代理"/><TextBlock Text="原生入站模式保留配置中的 TUN 和监听端口。TUN 需要管理员权限。" Style="{StaticResource Caption}"/><Button Content="以管理员身份重启" HorizontalAlignment="Left" Margin="0,18,0,0" Click="RestartElevatedClick"/></StackPanel></Border>
            <Border x:Name="TestSettings" Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="延迟测试" Style="{StaticResource SectionTitle}"/><TextBox x:Name="DelayUrlBox"/><TextBlock Text="经节点访问此地址；sing-box 需要 HTTPS。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
            <WrapPanel><Button Content="保存设置" Click="SaveSettingsClick"/><Button Content="退出 Wbox" Click="ExitClick"/></WrapPanel>
          </StackPanel>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <TextBlock x:Name="Notice" Grid.Row="2" Text="就绪" Foreground="#949494" FontSize="11" Margin="32,8,30,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
  </Grid>
</Window>
