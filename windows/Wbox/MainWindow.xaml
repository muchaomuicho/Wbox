<Window x:Class="Wbox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Wbox" Style="{StaticResource {x:Type Window}}" TextOptions.TextFormattingMode="Display" Title="Wbox" Width="1180" Height="810" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid Background="#F6F7F9">
    <Grid.ColumnDefinitions><ColumnDefinition Width="204"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#17191C"><Grid Margin="18,30,18,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="12,0,0,36"><StackPanel Orientation="Horizontal"><Image Source="pack://siteoforigin:,,,/wbox.png" Width="38" Height="38"/><TextBlock Text="Wbox" FontSize="26" FontWeight="SemiBold" Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><TextBlock Text="自由连接，简单一点。" Foreground="#747B85" FontSize="11" Margin="0,16,0,0"/></StackPanel>
      <StackPanel x:Name="NavigationPanel" Grid.Row="1"><RadioButton Style="{StaticResource Navigation}" Content="概览" Tag="&#xE80F;" GroupName="Navigation" IsChecked="True" Click="NavigateClick"/><RadioButton Style="{StaticResource Navigation}" Content="代理节点" Tag="&#xE774;" GroupName="Navigation" Click="NavigateClick"/><RadioButton Style="{StaticResource Navigation}" Content="配置与订阅" Tag="&#xE8A5;" GroupName="Navigation" Click="NavigateClick"/><RadioButton Style="{StaticResource Navigation}" Content="活动连接" Tag="&#xE839;" GroupName="Navigation" Click="NavigateClick"/><RadioButton Style="{StaticResource Navigation}" Content="运行日志" Tag="&#xE8F1;" GroupName="Navigation" Click="NavigateClick"/><RadioButton Style="{StaticResource Navigation}" Content="设置" Tag="&#xE713;" GroupName="Navigation" Click="NavigateClick"/></StackPanel>
      <StackPanel Grid.Row="2" Margin="12,0"><Border BorderBrush="#30333A" BorderThickness="0,1,0,0" Padding="0,18,0,0"><StackPanel><TextBlock x:Name="SidebarCore" Text="mihomo" Foreground="#D9DCE1" FontSize="12"/><TextBlock Text="双内核 · IPv6" Foreground="#747B85" FontSize="11" Margin="0,6,0,0"/></StackPanel></Border><TextBlock Text="WBOX / 0.2.0" Foreground="#545B65" FontSize="10" Margin="0,28,0,0"/></StackPanel>
    </Grid></Border>
    <Grid Grid.Column="1" Margin="32,28,32,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="PageTitle" Text="概览" FontSize="28" FontWeight="SemiBold"/><TextBlock x:Name="PageCaption" Text="连接状态与网络活动，一目了然。" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><Button x:Name="StartButton" Grid.Column="1" Content="⏻  连接代理" Background="#15845B" Foreground="White" FontWeight="SemiBold" Padding="22,13" Margin="0" VerticalAlignment="Center" Click="StartClick"/></Grid>
      <TabControl x:Name="MainTabs" Grid.Row="1" BorderThickness="0" Background="Transparent" SelectionChanged="PageChanged"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem Header="概览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="58" Height="58" CornerRadius="18" Background="#F0F2F4" Margin="0,0,18,0"><TextBlock x:Name="StateGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="StateLabel" Text="尚未连接" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="ConnectionHint" Text="导入节点或配置，开启你的第一次连接。" Style="{StaticResource Caption}" Margin="0,6,12,0"/></StackPanel><Border Grid.Column="2" Background="#F4F5F7" CornerRadius="7" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="ModeBadge" Text="单节点模式" Foreground="#656D77" FontSize="11"/></Border></Grid></Border>
          <UniformGrid Columns="4" Margin="0,0,-12,18">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="↑  本次上传" Style="{StaticResource Caption}"/><TextBlock x:Name="UploadTotal" Text="0 B" FontSize="26" Margin="0,12,0,6"/><TextBlock x:Name="UploadRate" Text="0 B/s" Style="{StaticResource Caption}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="↓  本次下载" Style="{StaticResource Caption}"/><TextBlock x:Name="DownloadTotal" Text="0 B" FontSize="26" Margin="0,12,0,6"/><TextBlock x:Name="DownloadRate" Text="0 B/s" Style="{StaticResource Caption}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="活动连接" Style="{StaticResource Caption}"/><TextBlock x:Name="ConnectionCount" Text="0 / 0" FontSize="26" Margin="0,12,0,6"/><TextBlock Text="入站 / 出站" Style="{StaticResource Caption}" ToolTip="内核报告的活动逻辑流，通常一条入站对应一条出站。"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,12,0" Padding="18"><StackPanel><TextBlock Text="内存占用" Style="{StaticResource Caption}"/><TextBlock x:Name="MemoryLabel" Text="—" FontSize="26" Margin="0,12,0,6"/><TextBlock Text="应用与内核" Style="{StaticResource Caption}"/></StackPanel></Border>
          </UniformGrid>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="流量趋势" FontWeight="SemiBold" FontSize="15"/><TextBlock Text="─ 下载  ┄ 上传" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel><local:TrafficChart x:Name="Chart" Grid.Row="1" Height="172" Margin="0,18,0,12"/><DockPanel Grid.Row="2"><TextBlock Text="最近 60 秒" Style="{StaticResource Caption}"/><TextBlock Text="现在" Style="{StaticResource Caption}" HorizontalAlignment="Right"/></DockPanel></Grid></Border>
            <Border Style="{StaticResource Card}" Grid.Column="1"><StackPanel><TextBlock Text="代理路由" Style="{StaticResource SectionTitle}"/><TextBlock Text="代理组" Style="{StaticResource Caption}" Margin="0,0,0,5"/><ComboBox x:Name="GroupsBox" SelectionChanged="GroupChanged" DisplayMemberPath="Name" ToolTip="连接后加载配置中的代理组"/><TextBlock Text="当前节点" Style="{StaticResource Caption}" Margin="0,12,0,5"/><ComboBox x:Name="GroupNodesBox" SelectionChanged="GroupNodeChanged"/><Button Content="测试延迟  ↗" Click="DelayClick" Margin="0,14,0,0"/></StackPanel></Border>
          </Grid><TextBlock x:Name="OverviewFootnote" Text="系统代理 · 127.0.0.1:10808 · IPv6 已启用" Style="{StaticResource Caption}" Margin="3,18,0,0"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="代理节点"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
          <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="添加节点" Style="{StaticResource SectionTitle}"/><TextBox x:Name="ImportText" Height="70" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" ToolTip="粘贴 ss://、vmess://、vless://、trojan://、hysteria2:// 或 tuic:// 分享链接，支持多行"/><WrapPanel Margin="0,14,0,0"><Button Content="＋ 导入分享链接" Style="{StaticResource PrimaryButton}" Click="ImportLinksClick"/><Button Content="从文件导入" Click="ImportNodesFileClick"/><Button Content="订阅管理  ↗" Click="OpenProfilesClick"/></WrapPanel></StackPanel></Border>
          <DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock x:Name="NodesHeading" Text="我的节点" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="测试延迟" Click="DelayNodeClick" Padding="14,8"/><Button Content="删除" Click="DeleteNodeClick" Padding="14,8" Margin="0"/></StackPanel></DockPanel>
          <Grid Grid.Row="2"><ListBox x:Name="NodesList" SelectionChanged="NodeChanged"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="10" Background="#E7EAEE"><TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding Protocol}" Foreground="#7C828B" FontSize="11" Margin="0,0,10,0"/><TextBlock Text="{Binding Server}" Foreground="#7C828B" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="350"/></StackPanel></StackPanel><TextBlock Grid.Column="2" Text="{Binding DelayText}" Foreground="#7C828B" VerticalAlignment="Center" Margin="12,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=NodesList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="36" Foreground="#BCC2CB" HorizontalAlignment="Center"/><TextBlock Text="你的节点，从这里开始" FontSize="17" HorizontalAlignment="Center" Margin="0,18,0,8"/><TextBlock Text="粘贴分享链接，或在订阅管理中添加订阅。" Style="{StaticResource Caption}"/></StackPanel></Grid>
        </Grid></TabItem>
        <TabItem Header="配置与订阅"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="运行模式" Style="{StaticResource SectionTitle}"/><WrapPanel Margin="0,0,0,16"><RadioButton x:Name="NodeMode" Content="单节点模式" GroupName="Mode" Checked="ModeChanged"/><RadioButton x:Name="ConfigMode" Content="配置文件模式" GroupName="Mode" Checked="ModeChanged"/></WrapPanel><TextBlock Text="使用节点列表快速连接，或加载包含路由规则的完整配置。" Style="{StaticResource Caption}" Margin="0,0,0,12"/><DockPanel><Button Content="选择配置" Click="ChooseConfigClick" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox x:Name="ConfigPathBox" IsReadOnly="True" ToolTip="sing-box 使用 JSON，mihomo 使用 YAML"/></DockPanel><TextBlock Text="JSON → sing-box     YAML → mihomo" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="订阅管理" Style="{StaticResource SectionTitle}"/><DockPanel><Button Content="导入 / 更新" Style="{StaticResource PrimaryButton}" Click="SubscriptionClick" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox x:Name="SubscriptionBox" ToolTip="输入 HTTP / HTTPS 订阅链接"/></DockPanel><TextBlock Text="已保存的订阅" Style="{StaticResource Caption}" Margin="0,14,0,6"/><ComboBox x:Name="SavedSubscriptionsBox" SelectionChanged="SubscriptionSelected"/><TextBlock Text="支持 Base64 节点列表、mihomo proxies 与 sing-box outbounds。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="延迟测试" Style="{StaticResource SectionTitle}"/><TextBox x:Name="DelayUrlBox"/><TextBlock Text="默认使用 Apple 测试页。sing-box 需要 HTTPS 地址。" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem Header="活动连接"><Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True"><Grid><DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="网络" Binding="{Binding Network}" Width="70"/><DataGridTextColumn Header="入站来源" Binding="{Binding Source}" Width="150"/><DataGridTextColumn Header="目标地址" Binding="{Binding Destination}" Width="*"/><DataGridTextColumn Header="出站链" Binding="{Binding Outbound}" Width="150"/><DataGridTextColumn Header="规则" Binding="{Binding Rule}" Width="100"/></DataGrid.Columns></DataGrid><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=ConnectionsGrid}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="暂无活动连接" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="连接代理后，在这里查看流量的去向。" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Grid></Border></TabItem>
        <TabItem Header="运行日志"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><TextBlock Text="最近 1000 条" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制" Click="CopyLogsClick" Padding="14,8"/><Button Content="清空" Click="ClearLogsClick" Padding="14,8" Margin="0"/></StackPanel></DockPanel><ListBox x:Name="LogsList" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#626975" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox><TextBlock Grid.Row="1" Text="连接后，运行日志会显示在这里。" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Caption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=LogsList}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Border></TabItem>
        <TabItem Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="连接偏好" Style="{StaticResource SectionTitle}"/><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="代理内核"/><TextBlock Text="只运行所选内核，切换后重新连接生效。" Style="{StaticResource Caption}" Margin="0,5,12,0"/></StackPanel><ComboBox x:Name="CoreBox" Grid.Column="1" SelectionChanged="CoreChanged"><ComboBoxItem Content="mihomo"/><ComboBoxItem Content="sing-box"/></ComboBox></Grid><CheckBox x:Name="SystemProxyCheck" Content="连接时启用系统代理"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="启动与后台" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AutoStartCheck" Content="Windows 开机自动启动"/><CheckBox x:Name="SilentCheck" Content="静默启动，仅显示托盘图标"/><CheckBox x:Name="AutoConnectCheck" Content="启动后自动连接"/><TextBlock Text="关闭主窗口会收起到托盘。退出 Wbox 会停止内核并恢复系统代理。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
          <WrapPanel><Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="SaveSettingsClick"/><Button Content="打开数据目录" Click="OpenDataClick"/><Button Content="退出 Wbox" Click="ExitClick"/></WrapPanel><TextBlock Text="Wbox 0.2.0  ·  mihomo 1.19.33 / sing-box 1.14.4" Style="{StaticResource Caption}" Margin="0,24,0,0"/>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <TextBlock x:Name="Notice" Grid.Row="2" Text="就绪" Foreground="#858C96" FontSize="11" Margin="2,16,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
  </Grid>
</Window>
