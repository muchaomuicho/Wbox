<Window x:Class="Wbox.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Wbox" Style="{StaticResource {x:Type Window}}" TextOptions.TextFormattingMode="Display" Title="Wbox" Width="1180" Height="830" MinWidth="980" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid Background="#1F1F1F">
    <Grid.ColumnDefinitions><ColumnDefinition Width="216"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="#181818" BorderBrush="#333333" BorderThickness="0,0,1,0">
      <Grid Margin="16,32,16,22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal" Margin="12,0,0,24"><Image Source="pack://siteoforigin:,,,/wbox.png" Width="34" Height="34"/><TextBlock Text="Wbox" FontSize="27" FontWeight="SemiBold" Margin="10,0,0,0"/></StackPanel>
          <TextBlock Text="工作区" Style="{StaticResource Caption}" Margin="12,0,0,8"/>
          <Border Background="#242424" CornerRadius="10" Padding="4" Margin="0,0,0,26"><UniformGrid Columns="2"><RadioButton x:Name="ConfigMode" Content="配置" GroupName="Mode" Padding="16,10" Checked="ModeChanged"/><RadioButton x:Name="NodeMode" Content="节点" GroupName="Mode" Padding="16,10" Checked="ModeChanged"/></UniformGrid></Border>
        </StackPanel>
        <StackPanel x:Name="NavigationPanel" Grid.Row="1">
          <RadioButton Style="{StaticResource Navigation}" Content="概览" Tag="&#xE80F;" GroupName="Navigation" IsChecked="True" Click="NavigateClick"/>
          <RadioButton x:Name="NodesNav" Style="{StaticResource Navigation}" Content="节点" Tag="&#xE774;" GroupName="Navigation" Click="NavigateClick"/>
          <RadioButton x:Name="ProfilesNav" Style="{StaticResource Navigation}" Content="订阅" Tag="&#xE8A5;" GroupName="Navigation" Click="NavigateClick"/>
          <RadioButton Style="{StaticResource Navigation}" Content="连接" Tag="&#xE839;" GroupName="Navigation" Click="NavigateClick"/>
          <RadioButton Style="{StaticResource Navigation}" Content="日志" Tag="&#xE8F1;" GroupName="Navigation" Click="NavigateClick"/>
          <RadioButton Style="{StaticResource Navigation}" Content="设置" Tag="&#xE713;" GroupName="Navigation" Click="NavigateClick"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="12,0"><TextBlock x:Name="SidebarCore" Text="sing-box" Foreground="#B6B6B6"/><TextBlock Text="0.3.0  ·  IPv6" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/><RowDefinition Height="34"/></Grid.RowDefinitions>
      <Border Background="#1B1B1B" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="30,0"><DockPanel><Button x:Name="StartButton" Content="⏻  连接" Background="#318566" Foreground="White" Padding="18,10" Margin="0,0,20,0" VerticalAlignment="Center" Click="StartClick"/><TextBlock x:Name="PageTitle" Text="概览" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="PageCaption" Text="节点工作区" Style="{StaticResource Caption}" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
      <TabControl Foreground="{StaticResource Ink}" x:Name="MainTabs" Grid.Row="1" Margin="30,28,30,0" BorderThickness="0" Background="Transparent" SelectionChanged="PageChanged">
        <TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
        <TabItem Header="概览"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StateGlyph" Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="#A0A0A0" FontSize="19" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Foreground="#E5E5E5" x:Name="StateLabel" Text="尚未连接" FontSize="16"/><TextBlock x:Name="ConnectionHint" Text="添加配置或节点开始连接" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel><Border Grid.Column="2" Background="#292929" CornerRadius="7" Padding="10,6" VerticalAlignment="Center"><TextBlock x:Name="ModeBadge" Text="节点工作区" Style="{StaticResource Caption}"/></Border></Grid>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="↑   上传" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="UploadRate" Text="0 B/s" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="UploadTotal" Text="0 B" Style="{StaticResource Caption}" Margin="0,8,0,0"/><local:TrafficChart x:Name="Chart" Series="Upload" Height="92" Margin="0,18,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="↓   下载" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DownloadRate" Text="0 B/s" FontSize="32" FontWeight="SemiBold"/><TextBlock x:Name="DownloadTotal" Text="0 B" Style="{StaticResource Caption}" Margin="0,8,0,0"/><local:TrafficChart x:Name="DownloadChart" Series="Download" Height="92" Margin="0,18,0,0"/></StackPanel></Border>
          </Grid>
          <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="状态" Style="{StaticResource SectionTitle}"/><DockPanel Margin="0,0,0,12"><TextBlock Text="内核内存" Style="{StaticResource Caption}"/><TextBlock x:Name="CoreMemoryLabel" Text="—" FontSize="17" HorizontalAlignment="Right"/></DockPanel><DockPanel><TextBlock Text="界面内存" Style="{StaticResource Caption}"/><TextBlock x:Name="MemoryLabel" Text="—" FontSize="17" HorizontalAlignment="Right"/></DockPanel></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="连接" Style="{StaticResource SectionTitle}"/><DockPanel Margin="0,0,0,12"><TextBlock Text="入站 / 出站" Style="{StaticResource Caption}"/><TextBlock x:Name="ConnectionCount" Text="0 / 0" FontSize="17" HorizontalAlignment="Right"/></DockPanel><TextBlock Text="活动逻辑连接" Style="{StaticResource Caption}"/></StackPanel></Border>
          </Grid>
          <Border Style="{StaticResource Card}"><DockPanel><Button Content="选择  ›" DockPanel.Dock="Right" Click="OpenProfilesClick" Margin="16,0,0,0" VerticalAlignment="Center"/><StackPanel><TextBlock Text="当前配置" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/><TextBlock x:Name="OverviewFootnote" Style="{StaticResource Caption}" Text="系统代理 · 127.0.0.1:10808 · IPv6"/></StackPanel></DockPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="NodesTab" Header="节点"><Grid>
          <Grid x:Name="NodeWorkspace"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,18"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="＋ 添加" Click="ShowImportClick"/><Button Content="测试所选" Click="DelayNodeClick"/><Button x:Name="DelayAllButton" Content="测试全部" Click="DelayAllClick"/><Button Content="删除" Click="DeleteNodeClick" Margin="0"/></StackPanel><TextBlock x:Name="NodesHeading" Text="节点" FontSize="17" VerticalAlignment="Center"/></DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions><ComboBox x:Name="NodeFilter" SelectionChanged="NodeFilterChanged"/><TextBox Tag="搜索名称、地址或协议" x:Name="NodeSearch" Grid.Column="2" TextChanged="NodeSearchChanged" ToolTip="搜索节点名称、地址或协议"/></Grid>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0"><Grid><DataGrid x:Name="NodesList" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="NodeChanged" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"><DataGrid.Columns><DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="180"/><DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="95"/><DataGridTextColumn Header="地址" Binding="{Binding Server}" Width="160"/><DataGridTextColumn Header="传输" Binding="{Binding TransportText}" Width="95"/><DataGridTextColumn Header="延迟" Binding="{Binding DelayText}" Width="82"/></DataGrid.Columns></DataGrid><StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Items.Count, ElementName=NodesList}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="还没有节点" FontSize="18" HorizontalAlignment="Center"/><TextBlock Text="添加分享链接，或到订阅页面添加订阅" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Grid></Border>
          </Grid>
          <StackPanel x:Name="GroupWorkspace" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="代理组" Style="{StaticResource SectionTitle}"/><TextBlock Text="连接配置后，选择代理组与节点。自动选择组由内核管理。" Style="{StaticResource Caption}" Margin="0,0,0,20"/><ComboBox x:Name="GroupsBox" SelectionChanged="GroupChanged" DisplayMemberPath="Name"/><TextBlock Text="节点" Style="{StaticResource Caption}" Margin="0,20,0,8"/><ComboBox x:Name="GroupNodesBox" SelectionChanged="GroupNodeChanged"/><Button Content="测试延迟" Click="DelayClick" HorizontalAlignment="Left" Margin="0,20,0,0"/></StackPanel></Border></StackPanel>
        </Grid></TabItem>
        <TabItem x:Name="ProfilesTab" Header="订阅"><Grid>
          <Grid x:Name="ConfigWorkspace" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><DockPanel><TextBlock Text="添加配置" Style="{StaticResource SectionTitle}"/><Button Content="导入本地文件" Click="ChooseConfigClick" HorizontalAlignment="Right" Margin="0"/></DockPanel><TextBlock Text="远程地址" Style="{StaticResource Caption}" Margin="0,6,0,8"/><DockPanel><Button Content="添加远程配置" Click="RemoteConfigClick" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox Tag="https://example.com/config" x:Name="RemoteConfigUrl" ToolTip="HTTPS 地址，无需 .json / .yaml 后缀"/></DockPanel><TextBlock Text="自动识别 JSON / YAML，保留完整路由、DNS 与代理组。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
            <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="我的配置" FontSize="16"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Content="更新远程" Click="UpdateConfigClick"/><Button Content="移除" Click="RemoveConfigClick" Margin="0"/></StackPanel></DockPanel><ListBox x:Name="ConfigsList" Grid.Row="1" SelectionChanged="ConfigSelected"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontSize="15"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
          </Grid>
          <StackPanel x:Name="SubscriptionWorkspace"><Border Style="{StaticResource Card}" Margin="0,0,0,20"><StackPanel><TextBlock Text="添加节点订阅" Style="{StaticResource SectionTitle}"/><DockPanel><Button Content="添加 / 更新" Click="SubscriptionClick" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBox Tag="https://example.com/subscription" x:Name="SubscriptionBox" ToolTip="HTTP / HTTPS 订阅链接，支持无文件后缀的地址"/></DockPanel><TextBlock Text="支持 Base64、分享链接列表，以及 JSON / YAML 中的节点。" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="已保存的订阅" Style="{StaticResource SectionTitle}"/><ComboBox x:Name="SavedSubscriptionsBox" SelectionChanged="SubscriptionSelected"/><WrapPanel Margin="0,18,0,0"><Button Content="更新全部订阅" Click="UpdateAllSubscriptionsClick"/><Button Content="移除所选订阅" Click="RemoveSubscriptionClick"/></WrapPanel></StackPanel></Border></StackPanel>
        </Grid></TabItem>
        <TabItem Header="连接"><Border Style="{StaticResource Card}" Padding="0"><DataGrid x:Name="ConnectionsGrid" AutoGenerateColumns="False" IsReadOnly="True" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="网络" Binding="{Binding Network}" Width="70"/><DataGridTextColumn Header="入站来源" Binding="{Binding Source}" Width="150"/><DataGridTextColumn Header="目标地址" Binding="{Binding Destination}" Width="*"/><DataGridTextColumn Header="出站链" Binding="{Binding Outbound}" Width="150"/><DataGridTextColumn Header="规则" Binding="{Binding Rule}" Width="100"/></DataGrid.Columns></DataGrid></Border></TabItem>
        <TabItem Header="日志"><Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="0,0,0,18"><TextBlock Text="最近 500 条" Style="{StaticResource Caption}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制" Click="CopyLogsClick"/><Button Content="清空" Click="ClearLogsClick" Margin="0"/></StackPanel></DockPanel><ListBox x:Name="LogsList" Grid.Row="1" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="#B0B0B0" ScrollViewer.HorizontalScrollBarVisibility="Auto"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0,5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="{TemplateBinding Padding}"/></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle></ListBox></Grid></Border></TabItem>
        <TabItem Header="设置"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="连接" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="节点工作区内核"/><TextBlock Text="配置工作区随所选配置切换内核" Style="{StaticResource Caption}" Margin="0,6,0,0"/></StackPanel><ComboBox x:Name="CoreBox" Grid.Column="1" SelectionChanged="CoreChanged"><ComboBoxItem Content="mihomo"/><ComboBoxItem Content="sing-box"/></ComboBox></Grid><CheckBox x:Name="SystemProxyCheck" Content="连接时启用系统代理"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="启动与后台" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AutoStartCheck" Content="Windows 开机自动启动"/><CheckBox x:Name="SilentCheck" Content="静默启动，仅显示托盘图标"/><CheckBox x:Name="AutoConnectCheck" Content="启动后自动连接"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="延迟测试" Style="{StaticResource SectionTitle}"/><TextBox x:Name="DelayUrlBox"/><TextBlock Text="经所选节点访问此地址；sing-box 需要 HTTPS。" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Border>
          <WrapPanel><Button Content="保存设置" Click="SaveSettingsClick"/><Button Content="数据目录" Click="OpenDataClick"/><Button Content="退出 Wbox" Click="ExitClick"/></WrapPanel><TextBlock Text="Wbox 0.3.0 · mihomo 1.19.33 / sing-box 1.14.4" Style="{StaticResource Caption}" Margin="0,20,0,10"/>
        </StackPanel></ScrollViewer></TabItem>
      </TabControl>
      <TextBlock x:Name="Notice" Grid.Row="2" Text="就绪" Foreground="#949494" FontSize="11" Margin="32,8,30,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </Grid>
  </Grid>
</Window>
