<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#1A1A1A</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F0F0F0</item>
        <item name="android:navigationBarColor">#F0F0F0</item>
        <item name="android:windowBackground">#FAFAFA</item>
        <item name="android:windowActionModeOverlay">false</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase"/>
    <style name="AppThemeDark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">#E5E5E5</item>
        <item name="android:windowBackground">#1F1F1F</item>
        <item name="android:statusBarColor">#242424</item>
        <item name="android:navigationBarColor">#242424</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
